+
+for (const [region, rate] of Object.entries(TAX_RATES)) {
+  registerTaxRule(region, (amount) => Math.round(amount * rate))
+}
+
+// Japanese consumption tax drops fractional units rather than rounding them.
+registerTaxRule('JP', (amount) => Math.floor(amount * 0.1))
+
