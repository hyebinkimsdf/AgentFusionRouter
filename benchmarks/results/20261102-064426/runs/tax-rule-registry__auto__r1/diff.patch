 import assert from 'node:assert/strict'
 import { test } from 'node:test'
 
-import { applyCoupon, applyTax } from '../src/pricing.js'
+import { applyCoupon, applyTax, registerTaxRule } from '../src/pricing.js'
 
 test('a coupon takes its percentage off', () => {
   assert.equal(applyCoupon(10000, 'WELCOME10'), 9000)
@@ -20,4 +20,20 @@ test('tax follows the region', () => {
 
 test('an unknown region is an error', () => {
   assert.throws(() => applyTax(1000, 'ZZ'))
+  assert.throws(() => applyTax(1000, 'constructor'))
+})
+
+test('Japanese tax is 10% rounded down', () => {
+  assert.equal(applyTax(1000, 'JP'), 100)
+  assert.equal(applyTax(1009, 'JP'), 100)
+  assert.equal(applyTax(1005, 'KR'), 101)
+})
+
+test('a registered rule decides the tax for its region', () => {
+  registerTaxRule('XX', amount => amount * 2)
+  assert.equal(applyTax(7, 'XX'), 14)
+})
+
+test('a tax rule must be a function', () => {
+  assert.throws(() => registerTaxRule('XX', 0.1), TypeError)
 })
