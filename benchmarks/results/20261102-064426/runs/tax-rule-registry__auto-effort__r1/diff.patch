diff --git a/src/pricing.js b/src/pricing.js
index 2b458ae..86ea86d 100644
--- a/src/pricing.js
+++ b/src/pricing.js
@@ -1,10 +1,24 @@
 // Amounts are whole currency units (won, cents) so totals never carry float error.
 
-export const TAX_RATES = {
-  KR: 0.1,
-  US: 0.08,
+// Each region's tax rule is a function (amount) => tax, so regions can round differently.
+const TAX_RULES = new Map()
+
+/** Make `rule` the tax rule for `region`, replacing any rule it already had. */
+export const registerTaxRule = (region, rule) => {
+  if (typeof rule !== 'function') throw new TypeError(`Tax rule for region ${region} must be a function`)
+
+  TAX_RULES.set(region, rule)
 }
 
+/** A rule that charges a flat rate, rounded to the nearest whole unit. */
+const flatRate = (rate) => (amount) => Math.round(amount * rate)
+
+registerTaxRule('KR', flatRate(0.1))
+registerTaxRule('US', flatRate(0.08))
+// Japan's 10% consumption tax drops any fraction of a yen. Dividing by 100 keeps exact
+// multiples exact, where `amount * 0.1` could land a hair below and floor a yen too low.
+registerTaxRule('JP', (amount) => Math.floor((amount * 10) / 100))
+
 export const COUPONS = {
   WELCOME10: 0.1,
   VIP20: 0.2,
@@ -17,10 +31,10 @@ export const applyCoupon = (amount, coupon) => {
   return Math.round(amount * (1 - rate))
 }
 
-/** The tax owed on an amount in a region, rounded to a whole unit. */
+/** The tax owed on an amount in a region, as computed by that region's registered rule. */
 export const applyTax = (amount, region) => {
-  const rate = TAX_RATES[region]
-  if (rate === undefined) throw new Error(`No tax rule for region ${region}`)
+  const rule = TAX_RULES.get(region)
+  if (rule === undefined) throw new Error(`No tax rule for region ${region}`)
 
-  return Math.round(amount * rate)
+  return rule(amount)
 }
